---
import { site } from '@shared/lib/site'
const configuredId = process.env.GOOGLE_SEARCH_ENGINE_ID || site.googleSearchEngineId
const engineId = /^[a-zA-Z0-9:_-]{1,100}$/.test(configuredId) ? configuredId : ''
---
<div class="card mb-4" data-google-search data-engine-id={engineId}>
  <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div><h3 class="mb-1">Search across job sites</h3><p class="text-secondary mb-0 small">{engineId ? 'Find more jobs using Google, right here.' : 'Search Google using your role and location. Results open in a new tab.'}</p></div>
    <a class="btn btn-primary" data-google-job-search href="https://www.google.com/search?q=jobs+Philippines" target="_blank" rel="noopener noreferrer">{engineId ? 'Search with Google' : 'Search jobs on Google'} &nearr;</a>
  </div>
  {engineId && <div class="card-body border-top d-none" data-google-results><p class="small text-secondary" data-google-status aria-live="polite">Loading Google results...</p><div class="gcse-searchresults-only" data-gname="joblink-jobs"></div><p class="text-secondary small mb-0">Google results link to external job websites. Save individual jobs manually in your application tracker.</p></div>}
</div>
<script>
  import '../../scripts/google-job-search'
</script>
