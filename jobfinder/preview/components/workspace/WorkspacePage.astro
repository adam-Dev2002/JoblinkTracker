---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import Icon from '@ui/Icon.astro'
import NewsExperience from '../news/NewsExperience.astro'
import WorkspaceTable from './WorkspaceTable.astro'
import DataPlaceholder from '@shared/components/DataPlaceholder.astro'
import { site } from '@shared/lib/site'
import { classifications } from '../../scripts/google-job-query'
interface Props {
  view: string
  title: string
  description: string
}
const { view, title, description } = Astro.props
const configuredGoogleEngine = process.env.GOOGLE_SEARCH_ENGINE_ID || site.googleSearchEngineId
const googleEngineId = /^[a-zA-Z0-9:_-]{1,100}$/.test(configuredGoogleEngine) ? configuredGoogleEngine : ''
const desk = [
  ['taskboard', 'Task board'],
  ['calendar', 'Calendar'],
  ['links', 'Links'],
  ['sheet', 'Sheet'],
]
---

<DefaultLayout title={title} description={description}>
  <div data-workspace-view={view} data-google-engine-id={view === 'jobs' ? googleEngineId : undefined} aria-busy="true">
    <p class="visually-hidden" role="status" data-workspace-loading>Loading your workspace...</p>
    <div class="alert alert-danger d-none workspace-error" role="alert" data-workspace-error></div>
    <button class="btn d-none mb-3" type="button" data-workspace-retry>Try again</button>
    {
      desk.some(([tool]) => tool === view) && (
        <div class="workspace-tabs">
          {desk.map(([tool, label]) => (
            <a class:list={[view === tool && 'active']} href={'/desk/' + tool}>
              {label}
            </a>
          ))}
        </div>
      )
    }
    {
      view === 'dashboard' && (
        <>
          <div class="row g-3 mb-4">
            {[
              ['applications', 'Applications', 'briefcase'],
              ['interviews', 'Interviews', 'messages'],
              ['tasks', 'Open tasks', 'checkbox'],
              ['events', 'Upcoming events', 'calendar'],
            ].map(([key, label, icon]) => (
              <div class="col-6 col-xl-3">
                <div class="card">
                  <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                      <span class="text-secondary">{label}</span>
                      <span class="text-primary">
                        <Icon name={icon!} />
                      </span>
                    </div>
                    <div class="stat-value" data-stat={key}>
                      <span class="placeholder col-4" aria-label="Loading" />
                    </div>
                    <div class="text-secondary small mt-1">From your workspace</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <div class="card mb-4" style="background:linear-gradient(120deg,#edf4ff,#ffffff)">
            <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
              <>
                <div>
                  <>
                    <div class="text-primary small fw-bold mb-2">YOUR NEXT OPPORTUNITY STARTS HERE</div>
                    <h2 class="mb-2">A little progress, every day.</h2>
                    <p class="text-secondary mb-0">Find a role, track your application, and plan what comes next.</p>
                  </>
                </div>
                <a href="/job-listing" class="btn btn-primary">
                  <Icon name="search" />
                  Find work
                </a>
              </>
            </div>
          </div>
          <div class="row g-4">
            <>
              <div class="col-lg-8">
                <div class="card" data-dashboard-application-panel>
                  <>
                    <div class="card-header d-flex justify-content-between">
                      <>
                        <h3 class="card-title">Recent applications</h3>
                        <a href="/applications">View tracker</a>
                      </>
                    </div>
                    <div data-dashboard-applications><DataPlaceholder /></div>
                  </>
                </div>
              </div>
              <div class="col-lg-4">
                <div class="card">
                  <>
                    <div class="card-header">
                      <h3 class="card-title">Your next steps</h3>
                    </div>
                    <div class="card-body" data-dashboard-tasks><DataPlaceholder count={3} /></div>
                  </>
                </div>
              </div>
            </>
          </div>
          <div class="row g-3 mt-2">
            {[
              ['Task board', 'Organize your day', '/desk/taskboard', 'layout-kanban'],
              ['Calendar', 'Make time for interviews', '/desk/calendar', 'calendar'],
              ['News & events', 'Stay in the loop', '/news', 'news'],
            ].map(([label, sub, url, icon]) => (
              <div class="col-md-4">
                <a href={url} class="card text-decoration-none text-body">
                  <div class="card-body d-flex gap-3 align-items-center">
                    <span class="avatar bg-primary-lt">
                      <Icon name={icon!} />
                    </span>
                    <div class="fw-semibold">
                      {label}
                      <div class="text-secondary small fw-normal">{sub}</div>
                    </div>
                    <span class="ms-auto">
                      <Icon name="arrow-right" />
                    </span>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </>
      )
    }
    {
      view === 'jobs' && (
        <>
          <div class="card mb-4">
            <div class="card-body">
              <form class="row g-3" data-job-search>
                <>
                  <div class="col-md-8">
                    <>
                      <label class="form-label" for="job-query">
                        Role or keyword
                      </label>
                      <div class="position-relative">
                        <>
                          <div class="input-group">
                            <button type="submit" class="input-group-text" aria-label="Search jobs" title="Search jobs">
                              <Icon name="search" />
                            </button>
                            <input type="search" class="form-control" id="job-query" name="q" placeholder="Search jobs, companies, or skills" maxlength="120" />
                          </div>
                          <div class="search-suggestions d-none" id="job-query-suggestions" role="listbox" aria-label="Job role suggestions" />
                        </>
                      </div>
                    </>
                  </div>
                  <div class="col-md-4">
                    <>
                      <label class="form-label" for="job-source">
                        Search feed
                      </label>
                      <select class="form-select" id="job-source" name="source">
                        <>
                          <option value="all">All job listings</option>
                          <option value="google">Google · job sites</option>
                          <option value="jobicy">Jobicy - remote jobs</option>
                          <option value="remotive">Remotive - free remote jobs</option>
                          <option value="arbeitnow">Arbeitnow - free Europe jobs</option>
                          {process.env.JSEARCH_API_KEY && <option value="jsearch">JSearch - connected feed</option>}
                        </>
                      </select>
                    </>
                  </div>
                </>
              </form>
              <p class="form-hint mt-2 mb-0">Search job listings by role, company, or skill. All job listings includes Google job-site results when you search.</p>
            </div>
          </div>
          <>
            <>
              <div class="card mb-3">
                <div class="card-body">
                  <>
                    <div class="row g-3">
                      <>
                        <div class="col-md-6 col-xl-4">
                          <>
                            <label class="form-label" for="job-location">
                              Place or location
                            </label>
                            <div class="position-relative">
                              <>
                                <input class="form-control" id="job-location" placeholder="Philippines, Manila, USA..." />
                                <div class="search-suggestions d-none" id="job-location-suggestions" role="listbox" aria-label="Location suggestions" />
                              </>
                            </div>
                          </>
                        </div>
                        <div class="col-md-6 col-xl-3">
                          <>
                            <label class="form-label" for="job-employment">
                              Employment type
                            </label>
                            <select class="form-select" id="job-employment">
                              <option value="">Any employment type</option>
                              {['Full-time', 'Part-time', 'Contract', 'Freelance', 'Internship', 'Temporary', 'Not specified'].map((type) => (
                                <option>{type}</option>
                              ))}
                            </select>
                          </>
                        </div>
                        <div class="col-md-6 col-xl-2">
                          <label class="form-label" for="job-listing-time">
                            Listing time
                          </label>
                          <select class="form-select" id="job-listing-time">
                            <option value="">Any time</option>
                            <option value="1">Last 24 hours</option>
                            <option value="3">Last 3 days</option>
                            <option value="7">Last 7 days</option>
                            <option value="14">Last 14 days</option>
                            <option value="30">Last 30 days</option>
                          </select>
                        </div>
                        <div class="col-md-6 col-xl-3">
                          <label class="form-label" for="job-classification">
                            Classification
                          </label>
                          <select class="form-select" id="job-classification">
                            <option value="">All classifications</option>
                            {classifications.map((classification) => (
                              <option>{classification}</option>
                            ))}
                          </select>
                        </div>
                      </>
                    </div>
                    <p class="form-hint mt-2 mb-0">Filter listings by location, employment type, listing time, and classification. Google filters refine the search; confirm job details and listing dates on the original website.</p>
                  </>
                </div>
              </div>
            </>
            <section class="border rounded-3 p-3 p-md-4 mb-4 job-results-panel" aria-labelledby="job-results-title">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <>
                  <h2 class="mb-0" id="job-results-title">
                    Explore opportunities
                  </h2>
                  <span class="text-secondary small" data-job-count />
                </>
              </div>
              <p class="text-secondary small" data-feed-message>
                Loading the live job feed
              </p>
              <div class="card border mb-3 job-selection-toolbar" data-job-selection-toolbar>
                <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                  <div class="d-flex flex-wrap align-items-center gap-3 job-selection-summary">
                    <label class="form-check mb-0">
                      <input class="form-check-input" type="checkbox" data-job-select-all disabled />
                      <span class="form-check-label">Select up to 50 new jobs</span>
                      <span class="form-hint" data-job-selection-scope>
                        Across all pages
                      </span>
                    </label>
                    <span class="text-secondary small" data-job-selected-count role="status">
                      0 selected · Max 50
                    </span>
                  </div>
                  <div class="d-flex flex-wrap gap-2 job-selection-actions">
                    <button type="button" class="btn btn-primary btn-sm" data-job-bulk-save disabled>
                      <Icon name="bookmark" />
                      Save selected
                    </button>
                    <button type="button" class="btn btn-sm" data-job-bulk-export disabled>
                      <Icon name="download" />
                      Export selected
                    </button>
                    <button type="button" class="btn btn-sm" data-job-clear-selection disabled>
                      Clear selection
                    </button>
                  </div>
                </div>
                <div class="card-footer small d-none" data-job-bulk-status role="status" aria-live="polite" />
              </div>
              <div class="row g-3" data-job-results><div class="col-12"><DataPlaceholder variant="cards" /></div></div>
              <template data-job-placeholder><DataPlaceholder variant="cards" /></template>
              <nav class="mt-4 d-none workspace-pagination" aria-label="Job results pages" data-job-pagination />
              <div class="d-none google-jobs-results" data-google-jobs aria-busy="false">
                <p class="text-secondary small" data-google-jobs-status role="status" aria-live="polite" />
                <div class="d-none" data-google-jobs-preview />
                <div data-google-jobs-host />
              </div>
            </section>
          </>
        </>
      )
    }
    {
      view === 'applications' && (
        <>
          <div class="row g-3 mb-4">
            {[
              ['total', 'Tracked jobs'],
              ['open', 'Still open'],
              ['interview', 'Interviews'],
              ['offer', 'Offers'],
              ['reply', 'Reply rate'],
            ].map(([key, label]) => (
              <div class="col-6 col-lg">
                <div class="card">
                  <div class="card-body">
                    <div class="text-secondary small mb-2">{label}</div>
                    <div class="stat-value" data-application-stat={key}>
                      <span class="placeholder col-4" aria-label="Loading" />
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <WorkspaceTable kind="application" title="Tracked applications" addLabel="Add application">
            <Fragment slot="toolbar">
              <div class="position-relative workspace-table-search">
                <input type="search" class="form-control" placeholder="Search your tracked jobs" aria-label="Search applications" data-item-search />
                <div class="search-suggestions d-none application-suggestions" id="application-search-suggestions" role="listbox" aria-label="Tracked jobs" data-application-suggestions />
              </div>
              <div class="dropdown">
                <button type="button" class="btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Filter" data-application-filter-toggle>Filter <span class="badge bg-primary-lt d-none ms-1" data-application-filter-badge /></button>
                <div class="dropdown-menu dropdown-menu-end p-3 workspace-filter-menu">
                  <label class="form-label" for="application-status-filter">Status</label>
                  <select id="application-status-filter" class="form-select mb-3" aria-label="Filter application status" data-status-filter>
                    <option value="">All statuses</option>
                    {['Saved', 'Application opened', 'Applied', 'Interview', 'Offer', 'Rejected', 'Ghosted'].map((status) => <option>{status}</option>)}
                  </select>
                  <label class="form-label" for="application-company-filter">Company</label>
                  <select id="application-company-filter" class="form-select" aria-label="Filter application company" data-application-company><option value="">All companies</option></select>
                  <button type="button" class="btn w-100 mt-3" data-application-clear-filters>Clear filters</button>
                </div>
              </div>
              <div class="dropdown">
                <button type="button" class="btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" data-application-sort-toggle>Sort by</button>
                <div class="dropdown-menu dropdown-menu-end p-3 workspace-filter-menu">
                  <label class="form-label" for="application-sort">Order applications</label>
                  <select id="application-sort" class="form-select" aria-label="Sort applications" data-application-sort>
                    <option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="title">Role A–Z</option><option value="company">Company A–Z</option><option value="status">Status A–Z</option>
                  </select>
                </div>
              </div>
              <span class="small text-secondary ms-sm-auto" role="status" data-application-filter-count />
            </Fragment>
            <div slot="selection" class="workspace-table-selection d-none" data-application-selection-toolbar>
              <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="fw-semibold" role="status" data-application-selected-count />
                <div class="dropdown ms-auto">
                  <button type="button" class="btn workspace-row-actions" data-bs-toggle="dropdown" aria-expanded="false">Selected actions <Icon name="chevron-down" class="workspace-action-chevron" /></button>
                  <div class="dropdown-menu dropdown-menu-end workspace-actions-menu">
                    <button type="button" class="dropdown-item" data-application-export-selected><Icon name="download" class="workspace-action-icon" />Export selected</button>
                    <button type="button" class="dropdown-item" data-application-clear-selection><Icon name="x" class="workspace-action-icon" />Clear selection</button>
                  </div>
                </div>
              </div>
            </div>
            <Fragment slot="columns">
              <th class="table-col-select"><input type="checkbox" class="form-check-input m-0" aria-label="Select all filtered applications across pages" data-application-all /></th>
              <th class="table-col-date">Date</th><th class="table-col-title">Role</th><th class="table-col-company">Company</th><th class="table-col-value">Salary</th><th class="table-col-status">Status</th><th class="table-col-notes">Notes</th><th class="table-col-actions">Actions</th>
            </Fragment>
          </WorkspaceTable>
        </>
      )
    }
    {
      view === 'taskboard' && (
        <div class="trello-workspace">
          <>
            <div class="trello-board-heading">
              <>
                <div>
                  <>
                    <h2 class="mb-1">My task board</h2>
                    <p class="mb-0 small">Drag cards between lists, or use their status menu.</p>
                  </>
                </div>
                <span class="badge bg-primary-lt">Your personal workspace</span>
              </>
            </div>
            <div class="task-board" data-task-board><DataPlaceholder variant="board" /></div>
          </>
        </div>
      )
    }
    {
      view === 'calendar' && (
        <>
          <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between mb-3">
            <>
              <div class="d-flex gap-2 align-items-center">
                <>
                  <button class="btn btn-icon" data-month-prev aria-label="Previous month">
                    <Icon name="chevron-left" />
                  </button>
                  <button class="btn" data-month-today>
                    Today
                  </button>
                  <button class="btn btn-icon" data-month-next aria-label="Next month">
                    <Icon name="chevron-right" />
                  </button>
                  <h2 class="mb-0 ms-2" data-month-title />
                </>
              </div>
              <button class="btn btn-primary" data-add="event">
                <Icon name="plus" />
                Add event
              </button>
            </>
          </div>
          <>
            <div class="card overflow-hidden">
              <>
                <div class="calendar-grid text-center text-secondary small py-2">
                  {['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'].map((day) => (
                    <span>{day}</span>
                  ))}
                </div>
                <div class="calendar-grid" data-calendar><DataPlaceholder variant="calendar" /></div>
              </>
            </div>
            <p class="text-secondary small mt-2">Event dates and times are shown in Manila time.</p>
            <div class="card mt-4">
              <>
                <div class="card-header">
                  <h3 class="card-title">Upcoming events</h3>
                </div>
                <div data-event-list><DataPlaceholder /></div>
              </>
            </div>
          </>
        </>
      )
    }
    {
      view === 'links' && (
        <>
          <>
            <div class="d-flex justify-content-between gap-3 mb-3">
              <>
                <input class="form-control" placeholder="Search your saved links" aria-label="Search links" data-item-search />
                <button class="btn btn-primary text-nowrap" data-add="link">
                  <Icon name="plus" />
                  Add link
                </button>
              </>
            </div>
            <div class="row g-3" data-link-list><div class="col-12"><DataPlaceholder variant="cards" /></div></div>
          </>
        </>
      )
    }

    {
      view === 'sheet' && (
        <section aria-label="Sheet workspace">
          <WorkspaceTable kind="sheet" title="Workspace sheet" addLabel="Add row">
            <Fragment slot="toolbar">
              <div class="position-relative workspace-table-search"><input type="search" class="form-control" placeholder="Search your sheet rows" aria-label="Search sheet" data-sheet-search /></div>
              <div class="dropdown">
                <button type="button" class="btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Filter">Filter <span class="badge bg-primary-lt d-none ms-1" data-sheet-filter-badge /></button>
                <div class="dropdown-menu dropdown-menu-end p-3 workspace-filter-menu">
                  <label class="form-label" for="sheet-attachment-filter">Attachments</label>
                  <select id="sheet-attachment-filter" class="form-select mb-3" aria-label="Filter sheet rows" data-sheet-filter><option value="all">All rows</option><option value="files">With attachments</option><option value="images">With pictures</option><option value="none">Without attachments</option></select>
                  <label class="form-label" for="sheet-company-filter">Company / category</label>
                  <select id="sheet-company-filter" class="form-select" aria-label="Filter sheet company" data-sheet-company><option value="">All companies / categories</option></select>
                  <button type="button" class="btn w-100 mt-3" data-sheet-clear-filters>Clear filters</button>
                </div>
              </div>
              <div class="dropdown">
                <button type="button" class="btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">Sort by</button>
                <div class="dropdown-menu dropdown-menu-end p-3 workspace-filter-menu">
                  <label class="form-label" for="sheet-sort">Order rows</label>
                  <select id="sheet-sort" class="form-select" aria-label="Sort sheet" data-sheet-sort><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="title">Title A–Z</option><option value="company">Company A–Z</option></select>
                </div>
              </div>
              <div class="dropdown">
                <button type="button" class="btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">Columns</button>
                <div class="dropdown-menu dropdown-menu-end p-3 workspace-filter-menu">
                  <div class="fw-semibold mb-3">Show columns</div>
                  {[
                    ['company', 'Company'], ['value', 'Value'], ['notes', 'Notes'], ['attachments', 'Attachments'],
                  ].map(([value, label]) => <label class="form-check mb-2"><input class="form-check-input" type="checkbox" checked value={value} data-sheet-column-toggle /><span class="form-check-label">{label}</span></label>)}
                </div>
              </div>
              <span class="small text-secondary ms-sm-auto" role="status" data-sheet-count />
            </Fragment>
            <div slot="selection" class="workspace-table-selection d-none" data-sheet-selection-toolbar>
              <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="fw-semibold" role="status" data-sheet-selected-count />
                <div class="dropdown ms-auto">
                  <button type="button" class="btn workspace-row-actions" data-bs-toggle="dropdown" aria-expanded="false">Selected actions <Icon name="chevron-down" class="workspace-action-chevron" /></button>
                  <div class="dropdown-menu dropdown-menu-end workspace-actions-menu">
                    <button type="button" class="dropdown-item" data-sheet-select><Icon name="checkbox" class="workspace-action-icon" />Select all results</button>
                    <button type="button" class="dropdown-item" data-sheet-export-selected><Icon name="download" class="workspace-action-icon" />Export selected</button>
                    <button type="button" class="dropdown-item" data-sheet-clear-selection disabled><Icon name="x" class="workspace-action-icon" />Clear selection</button>
                    <div class="dropdown-divider" />
                    <button type="button" class="dropdown-item text-danger" data-sheet-bulk disabled><Icon name="trash" class="workspace-action-icon" /><span data-sheet-bulk-label>Delete selected (0)</span></button>
                  </div>
                </div>
              </div>
            </div>
            <Fragment slot="columns">
              <th class="table-col-select"><input type="checkbox" class="form-check-input m-0" aria-label="Select all filtered sheet rows across pages" data-sheet-all /></th><th class="table-col-index">#</th><th class="table-col-title">Title / role</th><th class="table-col-company" data-sheet-column="company">Company / category</th><th class="table-col-value" data-sheet-column="value">Value</th><th class="table-col-notes" data-sheet-column="notes">Notes</th><th class="table-col-attachments" data-sheet-column="attachments">Attachments</th><th class="table-col-actions">Actions</th>
            </Fragment>
            <span slot="footer" class="visually-hidden" role="status" data-sheet-save-status />
          </WorkspaceTable>
        </section>
      )
    }
    {view === 'news' && <NewsExperience />}
    <div class="jobify-modal d-none job-details-overlay" role="dialog" aria-modal="true" aria-labelledby="job-details-title" data-job-details-modal>
      <section class="card job-details-panel">
        <div class="card-header d-flex justify-content-between"><span class="text-secondary small">JOB DETAILS</span><button class="btn btn-icon" aria-label="Close job details" data-job-close><Icon name="x" /></button></div><div class="card-body">
          <div class="d-flex gap-3 align-items-center mb-3"><span class="avatar bg-white border rounded-3 text-blue" data-details-logo></span><div><h2 id="job-details-title" class="mb-1" data-details-title></h2><div class="text-secondary" data-details-company></div></div></div><div
            class="d-flex flex-wrap gap-2 mb-4"
            data-details-tags
          >
          </div><h3>Job description</h3><div class="job-description-copy" data-details-description></div><div class="small text-secondary border-top pt-3 mt-4" data-details-source></div>
        </div><div class="card-footer d-flex flex-wrap gap-2 justify-content-between">
          <button class="btn" data-job-close>Back to results</button><div class="d-flex gap-2"><button class="btn" data-details-save>Save job</button><a class="btn btn-primary" data-details-apply target="_blank" rel="noopener noreferrer">Apply</a></div>
        </div>
      </section>
    </div>
    <button type="button" class="d-none" data-application-modal-trigger data-bs-toggle="modal" data-bs-target="#application-follow-up"></button>
    <div class="modal modal-blur fade" id="application-follow-up" tabindex="-1" aria-labelledby="application-follow-up-title" data-application-modal>
