---
import WorkspacePage from '../../components/workspace/WorkspacePage.astro'
export const prerender = true
export function getStaticPaths() {
  return [
    { params: { tool: 'taskboard' }, props: { title: 'Task board', description: 'Turn your plans into manageable next steps.' } },
    { params: { tool: 'calendar' }, props: { title: 'Calendar', description: 'Interviews, deadlines, and events in your own calendar.' } },
    { params: { tool: 'links' }, props: { title: 'Links', description: 'Keep the resources you reach for close at hand.' } },
    { params: { tool: 'sheet' }, props: { title: 'Sheet', description: 'A flexible home for your research and notes.' } },
  ]
}
const { title, description } = Astro.props
---

<WorkspacePage view={Astro.params.tool!} title={title} description={description} />
