---
import WorkspacePage from '../../components/workspace/WorkspacePage.astro'
import { redirectToLogin } from '../../server/page-auth.mjs'
export const prerender = false
Astro.response.headers.set('Cache-Control', 'no-store')
const loginRedirect = await redirectToLogin(Astro.request, Astro.url, Astro.isPrerendered, Astro.locals)
if (loginRedirect) return loginRedirect
const toolPages = {
  taskboard: { title: 'Task board', description: 'Turn your plans into manageable next steps.' },
  calendar: { title: 'Calendar', description: 'Interviews, deadlines, and events in your own calendar.' },
  links: { title: 'Links', description: 'Keep the resources you reach for close at hand.' },
  sheet: { title: 'Sheet', description: 'A flexible home for your research and notes.' },
}
const page = toolPages[Astro.params.tool as keyof typeof toolPages]
if (!page) return new Response('Page not found', { status: 404 })
const { title, description } = page
---

<WorkspacePage view={Astro.params.tool!} title={title} description={description} />
