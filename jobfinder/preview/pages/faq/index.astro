---
import BaseLayout from '@shared/layouts/BaseLayout.astro'
import Logo from '@shared/components/navbar/Logo.astro'
import JoblinkFooter from '@shared/components/JoblinkFooter.astro'
export const prerender = true
const questions = [
  { question: 'What can I do with JobLink?', answer: 'Find job opportunities, track applications, and organize your next steps with a task board, calendar, saved links, and a sheet.' },
  { question: 'Do I need an account?', answer: 'You can read the landing page and this FAQ without an account. Sign in or create an account when you want to use job search or your personal workspace.' },
  { question: 'Where do I apply for a job?', answer: 'Applications open on the original listing or employer website. Check the listing’s requirements and follow the application instructions there.' },
  { question: 'Does opening an application mean I have applied?', answer: 'Opening a job’s application page is recorded separately. Mark an application as Applied after you have submitted it on the employer’s website.' },
  { question: 'Will I need to sign in every time?', answer: 'Your session stays saved for up to 30 days. You may need to sign in again if you sign out, clear your browser cookies, or your session expires.' },
  { question: 'Who built JobLink?', answer: 'JobLink is built by Adam. Use the links in the footer to visit his portfolio and social profiles.' },
]
---

<BaseLayout title="Frequently asked questions" description="Answers to common questions about JobLink, accounts, job applications, and your workspace." assistant={false} publicStyles>
  <header class="faq-header"><Logo /><a class="btn" href="/job-listing" data-astro-prefetch>Find work</a></header>
  <main id="content" class="faq-content" data-public-info>
    <a class="faq-back" href="/" data-astro-prefetch>← Back to JobLink</a>
    <h1>Frequently asked questions</h1>
    <p class="text-secondary">A few things to know before your next step.</p>
    <div class="faq-questions">
      {questions.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
    </div>
  </main>
  <JoblinkFooter />
</BaseLayout>

<style>
  .faq-header { width: min(100%, 1140px); padding: 24px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .faq-content { width: min(100%, 800px); margin: 32px auto 64px; padding: 0 24px; }
  .faq-back { display: inline-block; margin-bottom: 24px; }
  h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.2; }
  .faq-questions { margin-top: 32px; }
  details { border-bottom: 1px solid #dce3eb; padding: 16px 0; }
  summary { cursor: pointer; font-weight: 600; font-size: 1rem; padding: 8px 0; }
  summary:focus-visible { outline: 2px solid #066fd1; outline-offset: 4px; }
  details p { margin: 12px 0 8px; color: var(--tblr-secondary); line-height: 1.7; }
</style>
