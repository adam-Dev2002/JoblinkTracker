---
import BaseLayout from './BaseLayout.astro'
import CopyrightNotice from '@shared/components/CopyrightNotice.astro'
import Logo from '@shared/components/navbar/Logo.astro'

interface Props {
  publicStyles?: boolean
  title?: string
  containerSize?: string
  hideLogo?: boolean
}

const { title, containerSize = 'tight', hideLogo, publicStyles = false } = Astro.props
---

<BaseLayout title={title} publicStyles={publicStyles}>
  <!-- BEGIN PAGE BODY -->
  <main class="page page-center" id="content">
    <div class:list={['container', containerSize !== 'normal' && `container-${containerSize}`, 'py-4']}>
      {
        !hideLogo && (
          <div class="text-center mb-4">
            <Logo />
          </div>
        )
      }

      <slot />
      <CopyrightNotice />
    </div>
  </main>
  <!-- END PAGE BODY -->
</BaseLayout>
