---
import { site } from '@shared/lib/site'
const year = new Intl.DateTimeFormat('en', { timeZone: 'Asia/Manila', year: 'numeric' }).format(new Date())
---

<footer class="joblink-footer" aria-label="JobLink footer">
  <div class="footer-inner">
    <h2>Find your <span>next opportunity</span> with JobLink.</h2>
    <div class="footer-columns">
      <nav aria-labelledby="footer-joblink-title">
        <h3 id="footer-joblink-title">JOBLINK</h3>
        <ul>
          <li><a href="/about" data-astro-prefetch>About</a></li>
          <li><a href="/faq" data-astro-prefetch>FAQ</a></li>
          <li><a href="/advertise" data-astro-prefetch>Advertise</a></li>
          <li><a href="/transparency" data-astro-prefetch>Transparency</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="footer-social-title">
        <h3 id="footer-social-title">CONNECT</h3>
        <ul>
          {site.socialLinks.map(link => (
            <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="footer-copyright">&copy; {year} <a href={site.copyrightOwnerUrl} target="_blank" rel="noopener noreferrer">{site.copyrightOwner}</a>. All rights reserved.</div>
  </div>
</footer>

<style>
  .joblink-footer { background: #fff; border-top: 1px solid #e5eaf1; color: #172d40; margin-top: 48px; }
  .footer-inner { box-sizing: border-box; width: 100%; max-width: 1140px; margin-inline: auto; padding: 56px 24px 100px; text-align: center; }
  h2 { margin: 0 auto 40px; max-width: 850px; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; line-height: 1.35; letter-spacing: -.025em; text-wrap: balance; }
  h2 span { background: #d7efff; padding: 0 .12em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .footer-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; max-width: 560px; margin-inline: auto; }
  h3 { margin: 0 0 16px; font-size: .875rem; font-weight: 700; letter-spacing: .035em; }
  ul { list-style: none; margin: 0; padding: 0; }
  a { color: #536273; text-decoration: none; overflow-wrap: anywhere; }
  li a { display: inline-flex; align-items: center; min-height: 44px; font-size: 1rem; }
  a:hover { color: #066fd1; text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid #066fd1; outline-offset: 4px; border-radius: 2px; }
  .footer-copyright { margin-top: 36px; padding-top: 24px; border-top: 1px solid #edf1f5; font-size: .8rem; color: #68788a; text-align: center; }
  @media (max-width: 575px) {
    .footer-inner { padding: 36px 20px calc(100px + env(safe-area-inset-bottom, 0px)); }
    h2 { margin-bottom: 28px; }
    .footer-columns { grid-template-columns: 1fr; gap: 24px; }
    .footer-copyright { margin-top: 28px; }
  }
  :global([data-bs-theme='dark']) .joblink-footer { background: #182433; color: #f0f4f8; border-color: #2e3e50; }
  :global([data-bs-theme='dark']) h2 span { background: #164769; }
  :global([data-bs-theme='dark']) a { color: #b9c9d9; }
  :global([data-bs-theme='dark']) .footer-copyright { border-color: #2e3e50; color: #b9c9d9; }
</style>
